# Copy this file to .env.local and fill in real values.
# Never commit .env.local to git.

# --- Contact Form (SMTP) ---
# See docs/EMAIL_SETUP.md for setup instructions.
# If these are empty, submissions are saved to /tmp/contact-submissions.jsonl instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
