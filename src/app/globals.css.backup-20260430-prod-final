/* Japanese Traditional Colors */
:root {
  --kon: #223A70;
  --ai: #264348;
  --sumi: #343434;
  --sakura: #FEDFE1;
  --gin: #97867C;
  --shiro: #FFFFFF;
}

/* Smooth scrolling */
html {
  font-size: 16px;
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

/* Selection color */
::selection {
  background-color: var(--sakura);
  color: var(--sumi);
}

/* Custom scrollbar */
::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: #f1f1f1;
}

::-webkit-scrollbar-thumb {
  background: var(--gin);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--kon);
}

/* Mobile responsive improvements */
@media (max-width: 640px) {
  html {
  font-size: 16px;
    font-size: 15px;
  }
  
  /* Prevent horizontal scroll */
  body {
    overflow-x: hidden;
  }
  
  /* Better touch targets */
  button, a {
    min-height: 44px;
  }
}

/* Touch device improvements */
@media (hover: none) {
  /* Disable hover effects on touch devices */
  .hover\:bg-kon:hover {
    background-color: inherit;
  }
}

/* PWA - Standalone mode adjustments */
@media (display-mode: standalone) {
  body {
    padding-top: env(safe-area-inset-top);
    padding-bottom: env(safe-area-inset-bottom);
    padding-left: env(safe-area-inset-left);
    padding-right: env(safe-area-inset-right);
  }
}

/* iOS notch support */
@supports (padding: max(0px)) {
  body {
    padding-left: max(12px, env(safe-area-inset-left));
    padding-right: max(12px, env(safe-area-inset-right));
  }
}

/* Prevent pull-to-refresh on mobile */
body {
  overscroll-behavior-y: contain;
}

/* Better focus states for accessibility */
:focus-visible {
  outline: 2px solid var(--kon);
  outline-offset: 2px;
}

/* Reduced motion for accessibility */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
  
  html {
  font-size: 16px;
    scroll-behavior: auto;
  }
}

/* Print styles */

/* Dark mode support (future) */
@media (prefers-color-scheme: dark) {
  /* Placeholder for dark mode - currently using light mode only */
}

/* Loading states */
.loading {
  opacity: 0.7;
  pointer-events: none;
}

/* File drop zone active state */
.drop-zone-active {
  border-color: var(--kon) !important;
  background-color: rgba(34, 58, 112, 0.05);
}

/* Custom animations for prompts */
@keyframes slide-up {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes bounce-slow {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-5px);
  }
}

.animate-slide-up {
  animation: slide-up 0.3s ease-out;
}

.animate-bounce-slow {
  animation: bounce-slow 2s ease-in-out infinite;
}

/* Safe area for iPhone bottom bar */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}


/* Print Styles */
@media print {
  /* Hide non-essential elements */
  header,
  footer,
  nav,
  .fixed,
  .sticky,
  button:not(.print-show),
  .no-print {
    display: none !important;
  }

  /* Reset backgrounds for ink saving */
  body {
    background: white !important;
    color: black !important;
  }

  /* Ensure content is readable */
  main {
    width: 100% !important;
    max-width: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  /* Show full URLs for links */
  a[href]:after {
    content: " (" attr(href) ")";
    font-size: 0.8em;
    color: #666;
  }

  /* Don't show URL for internal/button links */
  a[href^="#"]:after,
  a[href^="javascript"]:after,
  a.no-print-url:after {
    content: "" !important;
  }

  /* Page breaks */
  h1, h2, h3 {
    page-break-after: avoid;
  }

  img, table, pre {
    page-break-inside: avoid;
  }

  /* Ensure images print */
  img {
    max-width: 100% !important;
  }

  /* Tool result area - make prominent */
  .print-area {
    border: 1px solid #ccc;
    padding: 20px;
    margin: 20px 0;
  }
}

